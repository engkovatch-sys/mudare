APP_NAME=OrcamentosAltoPadrao
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# Banco de dados (PRODUCAO: MySQL no HostGator/cPanel)
# ----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orcamentos_db
DB_USERNAME=orcamentos_user
DB_PASSWORD=

# Para testar localmente SEM MySQL, comente as linhas acima e use:
# DB_CONNECTION=sqlite
# (crie o arquivo com: touch database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ----------------------------------------------------------------------
# Anthropic (Claude) - IA de extracao orcamentaria
# ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_TIMEOUT=60

# ----------------------------------------------------------------------
# Integracoes e PDF
# ----------------------------------------------------------------------
WEBHOOK_DEFAULT_URL=
PDF_LOGO_PATH=
PDF_BRAND_COLOR=#DD5600

MAIL_MAILER=log
MAIL_FROM_ADDRESS="orcamentos@exemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
